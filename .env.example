# MySQL Database settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=Clinic
DB_USERNAME=root
DB_PASSWORD=

# Clinic time zone used for check-in/out timestamps (PHP time zone name)
APP_TIMEZONE=Asia/Manila

# Show PHP error details in the browser. Keep false on any server others can reach.
APP_DEBUG=false

# How many students can have the chat open at once; others wait in the chat queue.
# Admins and nurses are never queued and don't count toward this.
CHAT_ACTIVE_LIMIT=5

# Pusher (real-time chat) — get free keys at https://dashboard.pusher.com/
# Use a separate Pusher app for each copy of the site (local, server), or their chats will mix.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1
